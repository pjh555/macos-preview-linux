MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/svg+xml;image/avif;image/heic;image/heif;video/mp4;video/webm;video/x-matroska;video/quicktime;video/mpeg;video/x-msvideo;video/ogg;video/x-m4v;
StartupNotify=true
